# ==============================================================================
# VE Loop Rewards — Backend Production Environment Configuration Template
# NOTE: Replace all placeholder values before deploying to staging/production.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (Standalone MongoDB, Replica Set, or MongoDB Atlas)
# In production, use a replica set or Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/user_profile_db

# Client / Frontend Origin for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# Authentication & JWT Configuration
# Required: Minimum 32-character high-entropy secret string in production
JWT_SECRET=replace_with_a_secure_random_32_character_secret_key_12345
JWT_EXPIRES_IN=24h

# Reverse Proxy / Load Balancer Configuration
# Set to 'true' or '1' if deployed behind Nginx, AWS ALB, Cloudflare, or similar reverse proxy
TRUST_PROXY=false
